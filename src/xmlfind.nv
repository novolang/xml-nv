// xmlfind.nv — ElementTree's find and findall, as named walks over the
// arena.
//
// Every function here is a named walk: over the children or over the
// descendants, by tag, by namespace and local name, by attribute, and
// upwards to an ancestor.  There is no path language.  ElementTree's
// "limited XPath" has `//`, `[@attr='v']` and `[position()]` and
// silently lacks axes, functions and unions, so an expression written
// by someone who knows XPath parses and answers the wrong nodes.  A
// signature here says what the walk does.
//
// A result is a node index, or a list of them in document order.
//
// The plain functions match the qualified name as written, which is
// what a document with no namespaces wants.  The `_ns` functions match
// the namespace URI and the local name, never the prefix, because a
// prefix is a spelling the document chose.

use xmltree

// The tag that matches every element: `*`, as ElementTree spells it.
// `findall(doc, i, "*")` is every element child.
pub const XML_ANY_TAG = "*"

// The first element child with this tag, or `None`.
//
// ElementTree's `find`.  It looks at the children only, not the
// descendants; `find_descendant` is the walk over everything below.
//
// ```novo
// use xmltree
// use xmlfind
//
// fn main() [io]
//     let doc = xmltree.build("<a><b/><c/></a>")
//     match xmlfind.find(doc, 1, "c")
//         Some(i) => println(xmltree.tag_of(doc, i))
//         None    => println("absent")
// ```
pub fn find(doc: xmltree.XmlDocument, from: Int, tag: Str) -> ?Int []
    for c in xmltree.element_children(doc, from)
        if matches(doc, c, tag)
            return Some(c)
    None

// Every element child with this tag, in source order.
//
// ElementTree's `findall`.  `XML_ANY_TAG` matches every element.
//
// ```novo
// use std.list
// use xmltree
// use xmlfind
//
// fn main() [io]
//     let doc = xmltree.build("<a><b/><b/><c/></a>")
//     let hits = xmlfind.findall(doc, 1, "b")
//     println("${list.len(hits)}")
// ```
pub fn findall(doc: xmltree.XmlDocument, from: Int, tag: Str) -> [Int] []
    list.filter(xmltree.element_children(doc, from), c => matches(doc, c, tag))

// The first element child in this namespace with this local name.
//
// ```novo
// use xmltree
// use xmlfind
//
// fn main() [io]
//     let doc = xmltree.build("<a xmlns:p=\"urn:x\"><p:b/></a>")
//     match xmlfind.find_ns(doc, 1, "urn:x", "b")
//         Some(i) => println(xmltree.local_of(doc, i))
//         None    => println("absent")
// ```
pub fn find_ns(doc: xmltree.XmlDocument, from: Int, uri: Str, local: Str) -> ?Int []
    for c in xmltree.element_children(doc, from)
        if in_ns(doc, c, uri, local)
            return Some(c)
    None

// Every element child in this namespace with this local name.
//
// ```novo
// use std.list
// use xmltree
// use xmlfind
//
// fn main() [io]
//     let doc = xmltree.build("<a xmlns:p=\"urn:x\"><p:b/><p:b/></a>")
//     let hits = xmlfind.findall_ns(doc, 1, "urn:x", "b")
//     println("${list.len(hits)}")
// ```
pub fn findall_ns(doc: xmltree.XmlDocument, from: Int, uri: Str, local: Str) -> [Int] []
    list.filter(xmltree.element_children(doc, from), c => in_ns(doc, c, uri, local))

// The first descendant element with this tag, in document order.
//
// What ElementTree's `find(".//tag")` answers.
//
// ```novo
// use xmltree
// use xmlfind
//
// fn main() [io]
//     let doc = xmltree.build("<a><b><c/></b></a>")
//     match xmlfind.find_descendant(doc, 1, "c")
//         Some(i) => println(xmltree.tag_of(doc, i))
//         None    => println("absent")
// ```
pub fn find_descendant(doc: xmltree.XmlDocument, from: Int, tag: Str) -> ?Int []
    for c in xmltree.descendants(doc, from)
        if matches(doc, c, tag)
            return Some(c)
    None

// Every descendant element with this tag, in document order.
//
// ElementTree's `iter(tag)`.  The node itself is not a candidate, so
// `findall_descendants(doc, i, tag_of(doc, i))` does not answer `i`.
//
// ```novo
// use std.list
// use xmltree
// use xmlfind
//
// fn main() [io]
//     let doc = xmltree.build("<a><b><c/></b><c/></a>")
//     let hits = xmlfind.findall_descendants(doc, 1, "c")
//     println("${list.len(hits)}")
// ```
pub fn findall_descendants(doc: xmltree.XmlDocument, from: Int, tag: Str) -> [Int] []
    list.filter(xmltree.descendants(doc, from), c => matches(doc, c, tag))

// Every descendant element in this namespace with this local name.
//
// ```novo
// use std.list
// use xmltree
// use xmlfind
//
// fn main() [io]
//     let doc = xmltree.build("<a xmlns:p=\"urn:x\"><q><p:b/></q></a>")
//     let hits = xmlfind.findall_descendants_ns(doc, 1, "urn:x", "b")
//     println("${list.len(hits)}")
// ```
pub fn findall_descendants_ns(doc: xmltree.XmlDocument, from: Int, uri: Str, local: Str) -> [Int] []
    list.filter(xmltree.descendants(doc, from), c => in_ns(doc, c, uri, local))

// The first element child carrying this attribute with this value.
//
// The `[@attr='v']` predicate, as a call.  `value` is compared with the
// decoded attribute value, so `&amp;` in the document matches `&` in
// the argument.
//
// ```novo
// use xmltree
// use xmlfind
//
// fn main() [io]
//     let doc = xmltree.build("<a><b id=\"1\"/><b id=\"2\"/></a>")
//     match xmlfind.find_by_attr(doc, 1, "id", "2")
//         Some(i) => println(xmltree.attr(doc, i, "id") ?? "")
//         None    => println("absent")
// ```
pub fn find_by_attr(doc: xmltree.XmlDocument, from: Int, name: Str, value: Str) -> ?Int []
    for c in xmltree.element_children(doc, from)
        if xmltree.attr(doc, c, name) == Some(value)
            return Some(c)
    None

// Every element child carrying this attribute with this value.
//
// ```novo
// use std.list
// use xmltree
// use xmlfind
//
// fn main() [io]
//     let doc = xmltree.build("<a><b k=\"x\"/><c k=\"x\"/></a>")
//     let hits = xmlfind.findall_by_attr(doc, 1, "k", "x")
//     println("${list.len(hits)}")
// ```
pub fn findall_by_attr(doc: xmltree.XmlDocument, from: Int, name: Str, value: Str) -> [Int] []
    list.filter(xmltree.element_children(doc, from), c => xmltree.attr(doc, c, name) == Some(value))

// The first element child carrying this attribute at all.
//
// The `[@attr]` predicate.
//
// ```novo
// use xmltree
// use xmlfind
//
// fn main() [io]
//     let doc = xmltree.build("<a><b/><c href=\"u\"/></a>")
//     match xmlfind.find_with_attr(doc, 1, "href")
//         Some(i) => println(xmltree.tag_of(doc, i))
//         None    => println("absent")
// ```
pub fn find_with_attr(doc: xmltree.XmlDocument, from: Int, name: Str) -> ?Int []
    for c in xmltree.element_children(doc, from)
        if xmltree.attr(doc, c, name) != None
            return Some(c)
    None

// Every descendant element carrying this attribute with this value.
//
// Every `<link rel="alternate">` anywhere under a feed, for example.
//
// ```novo
// use std.list
// use xmltree
// use xmlfind
//
// fn main() [io]
//     let doc = xmltree.build("<a><b><c r=\"alt\"/></b></a>")
//     let hits = xmlfind.findall_descendants_by_attr(doc, 1, "r", "alt")
//     println("${list.len(hits)}")
// ```
pub fn findall_descendants_by_attr(doc: xmltree.XmlDocument, from: Int, name: Str,
                                   value: Str) -> [Int] []
    list.filter(xmltree.descendants(doc, from),
                c => xmltree.is_element(doc, c) and xmltree.attr(doc, c, name) == Some(value))

// The inner text of the first element child with this tag, or a
// default.
//
// ElementTree's `findtext`, with one difference: the text is every
// descendant text node and CDATA section concatenated, as
// `xmltree.inner_text` answers it.  ElementTree answers only the text
// before the first child, so for `<title>a<b/>c</title>` it answers
// `"a"` where this answers `"ac"`.
//
// ```novo
// use xmltree
// use xmlfind
//
// fn main() [io]
//     let doc = xmltree.build("<a><t>hi</t></a>")
//     println(xmlfind.findtext(doc, 1, "t", ""))
// ```
pub fn findtext(doc: xmltree.XmlDocument, from: Int, tag: Str, fallback: Str) -> Str []
    match find(doc, from, tag)
        Some(i) => xmltree.inner_text(doc, i)
        None    => fallback

// The inner text of the first element child in this namespace with
// this local name, or a default.
//
// ```novo
// use xmltree
// use xmlfind
//
// fn main() [io]
//     let doc = xmltree.build("<a xmlns:p=\"urn:x\"><p:t>hi</p:t></a>")
//     println(xmlfind.findtext_ns(doc, 1, "urn:x", "t", ""))
// ```
pub fn findtext_ns(doc: xmltree.XmlDocument, from: Int, uri: Str, local: Str,
                   fallback: Str) -> Str []
    match find_ns(doc, from, uri, local)
        Some(i) => xmltree.inner_text(doc, i)
        None    => fallback

// Every ancestor of a node, nearest first, up to and including the
// document node.
//
// For a caller that found a node by attribute and wants the record it
// belongs to.
//
// ```novo
// use std.list
// use xmltree
// use xmlfind
//
// fn main() [io]
//     let doc = xmltree.build("<a><b><c/></b></a>")
//     println("${list.len(xmlfind.ancestors(doc, 3))}")
// ```
pub fn ancestors(doc: xmltree.XmlDocument, index: Int) -> [Int] []
    var out: [Int] = []
    var up = parent_of(doc, index)
    for _ in 0..xmltree.count(doc)
        if up < 0
            break
        list.push(out, up)
        up = parent_of(doc, up)
    out

// The nearest ancestor element with this tag, or `None`.
//
// ```novo
// use xmltree
// use xmlfind
//
// fn main() [io]
//     let doc = xmltree.build("<a><b><c/></b></a>")
//     match xmlfind.closest(doc, 3, "a")
//         Some(i) => println(xmltree.tag_of(doc, i))
//         None    => println("absent")
// ```
pub fn closest(doc: xmltree.XmlDocument, index: Int, tag: Str) -> ?Int []
    for a in ancestors(doc, index)
        if matches(doc, a, tag)
            return Some(a)
    None

// Whether an element's name matches a tag, with `XML_ANY_TAG`
// honoured.
//
// The comparison every function above makes, for a caller writing a
// walk this module does not have.
//
// ```novo
// use xmltree
// use xmlfind
//
// fn main() [io]
//     let doc = xmltree.build("<a/>")
//     let any = xmlfind.matches(doc, 1, "*")
//     println("${any}")
// ```
pub fn matches(doc: xmltree.XmlDocument, index: Int, tag: Str) -> Bool []
    xmltree.is_element(doc, index) and (tag == XML_ANY_TAG or xmltree.tag_of(doc, index) == tag)

// Whether a node is an element in namespace `uri` with local name
// `local`.
fn in_ns(doc: xmltree.XmlDocument, index: Int, uri: Str, local: Str) -> Bool
    xmltree.namespace_of(doc, index) == Some(uri) and xmltree.local_of(doc, index) == local

// A node's parent, or -1 for the document node and for an index that
// names nothing.
fn parent_of(doc: xmltree.XmlDocument, index: Int) -> Int
    match xmltree.node(doc, index)
        Some(n) => n.parent
        None    => 0 - 1
