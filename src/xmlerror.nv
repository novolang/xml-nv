// xmlerror.nv — the one fault type, and the offsets it happened at.
//
// XML 1.0 section 1.2 makes a well-formedness error fatal: a conforming
// processor "MUST NOT continue normal processing" after one.  The
// scanner in `xmlparse` therefore answers the first error as a fault
// and stops.  `xmltree.build` takes the same faults and, for the four
// that `is_recoverable` names, records an issue and goes on.
//
// A fault carries two byte offsets into the source and nothing else.
// `xmlparse.line_of` and `xmlparse.column_of` turn an offset into a
// position when a diagnostic needs one, so a caller that only wants to
// know whether a document parsed never pays for the scan.

// What was wrong, named.
//
// ```novo
// use xmlerror
//
// fn main() [io]
//     println(xmlerror.kind_name(XmlBadEntity))
// ```
pub enum XmlFaultKind
    // The document ended inside a construct: a tag, a comment, a CDATA
    // section, a processing instruction, an attribute value or an open
    // element.  A document with no element at all ends this way too.
    XmlUnexpectedEnd
    // A name that is not an XML 1.0 Name: it began with a digit, a
    // hyphen or a full stop, or it holds a character the production
    // does not allow.
    XmlBadName
    // `<` where no tag can start, a tag whose contents are not
    // attributes and a closing `>`, or `<` inside an attribute value.
    XmlBadTag
    // An end tag whose name is not the open element's.
    XmlMismatchedEnd
    // An end tag with nothing open.  `xmltree` also records this kind
    // for an end tag that matches no open element and is dropped.
    XmlStrayEnd
    // An attribute value that was not quoted.  XML has no bare
    // attribute values.
    XmlUnquotedAttribute
    // The same attribute name twice on one element, which XML 1.0
    // section 3.1 forbids.
    XmlDuplicateAttribute
    // `&name;` where `name` is not one of the five predefined entities,
    // or an `&` that does not start a reference.  A document that
    // defines its own entities in an internal DTD subset lands here.
    XmlBadEntity
    // `&#...;` naming a code point outside XML 1.0's Char production: a
    // surrogate, U+FFFE or U+FFFF, a C0 control other than tab, line
    // feed and carriage return, or a number that is not one.
    XmlBadCharRef
    // `--` inside a comment, or a comment ending `--->`.
    XmlBadComment
    // A CDATA section outside the root element, or `]]>` in character
    // data where no section was open.
    XmlBadCData
    // A processing instruction whose target is `xml` in another case,
    // or whose target is not followed by a space or `?>`.
    XmlBadProcessingInstruction
    // An XML declaration that is not the document's first construct or
    // is malformed, or a document type declaration after the root
    // element or after another one.
    XmlBadDeclaration
    // An `encoding=` naming anything but UTF-8.  A `Str` is UTF-8, and
    // this package has no transcoding tables.
    XmlUnsupportedEncoding
    // More than one element at the top level.
    XmlMultipleRoots
    // Content outside the root element that is not a comment, a
    // processing instruction or whitespace.
    XmlTrailingContent
    // A namespace prefix used where no declaration of it is in scope.
    XmlUndeclaredPrefix
    // `xmlns:xml` bound to a URI other than the XML namespace, the
    // `xmlns` prefix declared, another prefix bound to either reserved
    // URI, or a prefix bound to the empty string (XML Namespaces 1.0
    // section 3).
    XmlBadNamespaceDeclaration
    // An `XmlLimits` bound was reached: nesting depth, attribute count
    // or name length.
    XmlLimitExceeded
    // A character XML 1.0's Char production does not allow, written
    // directly rather than as a reference: a C0 control other than tab,
    // line feed and carriage return, U+FFFE, U+FFFF, or bytes that are
    // not UTF-8.
    XmlBadChar

// A fault: what, and where.
//
// ```novo
// use xmlerror
//
// fn main() [io]
//     let f = xmlerror.fault(XmlStrayEnd, 12, 16)
//     println("${f.at}")
// ```
pub struct XmlFault
    kind: XmlFaultKind
    // The byte offset where the faulty construct starts, counted from
    // the start of the source.
    at: Int
    // The byte offset just past the faulty construct, so a diagnostic
    // can underline it.  Equal to `at` when the end is not known.
    to: Int

// `XmlFault` is an `Error`, so a `Result` holding one is reported by
// anything that reports errors.
impl Error for XmlFault
    // `xmlerror.message` of the fault.
    fn message(self) -> Str
        message(self)

// A fault from its parts.
//
// ```novo
// use xmlerror
//
// fn main() [io]
//     println(xmlerror.kind_name(xmlerror.fault(XmlBadName, 4, 9).kind))
// ```
pub fn fault(kind: XmlFaultKind, at: Int, to: Int) -> XmlFault []
    XmlFault { kind: kind, at: at, to: to }

// The kind's name, in the spelling a message uses.
//
// Lower case with hyphens, `bad-entity` and `mismatched-end`, and
// stable across releases, because programs quote them.
//
// ```novo
// use xmlerror
//
// fn main() [io]
//     println(xmlerror.kind_name(XmlMismatchedEnd))
// ```
pub fn kind_name(kind: XmlFaultKind) -> Str []
    match kind
        XmlUnexpectedEnd            => "unexpected-end"
        XmlBadName                  => "bad-name"
        XmlBadTag                   => "bad-tag"
        XmlMismatchedEnd            => "mismatched-end"
        XmlStrayEnd                 => "stray-end"
        XmlUnquotedAttribute        => "unquoted-attribute"
        XmlDuplicateAttribute       => "duplicate-attribute"
        XmlBadEntity                => "bad-entity"
        XmlBadCharRef               => "bad-char-ref"
        XmlBadComment               => "bad-comment"
        XmlBadCData                 => "bad-cdata"
        XmlBadProcessingInstruction => "bad-processing-instruction"
        XmlBadDeclaration           => "bad-declaration"
        XmlUnsupportedEncoding      => "unsupported-encoding"
        XmlMultipleRoots            => "multiple-roots"
        XmlTrailingContent          => "trailing-content"
        XmlUndeclaredPrefix         => "undeclared-prefix"
        XmlBadNamespaceDeclaration  => "bad-namespace-declaration"
        XmlLimitExceeded            => "limit-exceeded"
        XmlBadChar                  => "bad-char"

// One line about the fault: the kind's name and the byte offset.
//
// The source is not quoted, because this module never sees it.  A
// message naming the offending text is built by the caller from the
// offsets and its own copy of the source.
//
// ```novo
// use xmlerror
//
// fn main() [io]
//     println(xmlerror.message(xmlerror.fault(XmlUnexpectedEnd, 31, 31)))   // unexpected-end at byte 31
// ```
pub fn message(f: XmlFault) -> Str []
    "${kind_name(f.kind)} at byte ${f.at}"

// Whether `xmltree.build` recovers from a fault of this kind rather
// than stopping at it.
//
// The four are `XmlMismatchedEnd`, `XmlStrayEnd`, `XmlUnexpectedEnd`
// and `XmlUndeclaredPrefix`: a tree can be built past each of them by
// closing, dropping or leaving a name unresolved.  After any other
// fault the scanner cannot say what the next event is.
//
// ```novo
// use xmlerror
//
// fn main() [io]
//     println("${xmlerror.is_recoverable(XmlStrayEnd)}")
// ```
pub fn is_recoverable(kind: XmlFaultKind) -> Bool []
    match kind
        XmlMismatchedEnd    => true
        XmlStrayEnd         => true
        XmlUnexpectedEnd    => true
        XmlUndeclaredPrefix => true
        _                   => false
